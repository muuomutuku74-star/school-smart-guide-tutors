--- .env.example (原始)
# ── School Smart Guide Tutors — environment template ─────────────────────
# Copy to .env and fill in real values. NEVER commit real secrets to Git.
# Values prefixed VITE_ are exposed to the browser — only use them for
# PUBLIC flags. All real secrets must live server-side.

# Database (PostgreSQL via Prisma in production)
DATABASE_URL=postgresql://ssgt:password@localhost:5432/ssgt

# Auth
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=72

# M-Pesa (Safaricom Daraja) — server-side ONLY
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.ssgt.ac.ke/payments/mpesa/callback
# Public flag: presence switches the client from sandbox to live payments UI
VITE_MPESA_CONSUMER_KEY=

# Card payments (PSP — Flutterwave / Paystack / Interswitch)
PSP_PUBLIC_KEY=
PSP_SECRET_KEY=

# Object storage for PDFs, videos, submissions (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=ssgt-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email provider (resend | smtp | ses) — server-side
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=School Smart Guide Tutors <hello@ssgt.ac.ke>


